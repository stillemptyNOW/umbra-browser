{
  "name": "Umbra",
  "tagline": "Your browsing, in shadow.",
  "id": "io.umbra.browser",
  "color": {
    "void": "#04030A",
    "surface": "#0A0812",
    "surfaceRaised": "#14101F",
    "surfaceHover": "#1D1730",
    "border": "#2A2140",
    "text": "#EDEAF7",
    "textMuted": "#9A93B5",
    "textFaint": "#655D80",
    "accent": "#7726FA",
    "accentBright": "#9B5CFF",
    "accentSoft": "#A78BFA",
    "success": "#3DD68C",
    "warn": "#F2B155",
    "danger": "#F2555A"
  },
  "radius": { "sm": 6, "md": 10, "lg": 14, "pill": 999 },
  "font": {
    "ui": "Inter, 'Segoe UI Variable Text', 'Segoe UI', -apple-system, BlinkMacSystemFont, system-ui, 'Helvetica Neue', sans-serif",
    "mono": "'JetBrains Mono', 'Cascadia Code', 'SF Mono', Consolas, monospace"
  }
}
